{
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./*.pem)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/time-context.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/predict-first.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-destructive.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-git-add-all.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-env-commit.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-endless-wait.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/zsh-traps.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/protect-secrets.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-on-write.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/prose-file-check.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/untrusted-content-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-slop-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/done-needs-proof.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/unfinished-work-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/scope-cut-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-homework.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/link-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/skim-check.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/numbers-need-sources.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/unpushed-work-check.sh"
          }
        ]
      }
    ]
  }
}
